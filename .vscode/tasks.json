{
    "version": "2.0.0",
    "tasks": [
        {
            "type": "shell",
            "command": "npm run dev",
            "label": "dev: supervisor",
            "detail": "Backend + TypeScript, Sass and Rollup watchers; dashboard at http://localhost:5000/supervisor/",
            "group": "build",
            "isBackground": true,
            "problemMatcher": {
                "owner": "vidyano-dev",
                "pattern": { "regexp": "^$" },
                "background": {
                    "activeOnStart": true,
                    "beginsPattern": "^◆ Starting the backend",
                    "endsPattern": "^Supervisor: http"
                }
            }
        }
    ]
}
